                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#1C5FB0" />
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#454545" />
