                    <SolidColorBrush x:Key="ZsTrough" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ZsWarning" Color="#E5A50A" />

                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1C5FB0" />
