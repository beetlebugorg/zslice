                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#1C5FB0" />
                            <SolidColorBrush x:Key="AccentButtonBackground" Color="#1C5FB0" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2468BD" />
