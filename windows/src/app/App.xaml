            </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

            <!-- The buttons of the other apps: a flat tint, with no border. -->
            <Style x:Key="ZsButtonBase" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource ZsButton}" />
                <Setter Property="Foreground" Value="{ThemeResource ZsFg}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource ZsButtonBase}" />
            <Style TargetType="DropDownButton">
                <Setter Property="Background" Value="{ThemeResource ZsButton}" />
                <Setter Property="Foreground" Value="{ThemeResource ZsFg}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <!-- The main action: the accent color. -->
            <Style x:Key="ZsSuggested" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource ZsAccent}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- A button of the header: an icon, 32 px. -->
            <Style x:Key="ZsHeaderIcon" TargetType="Button" BasedOn="{StaticResource ZsButtonBase}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <!-- The next parts of the setup group have a line at the left. -->
            <Style x:Key="ZsSetupPartNext" TargetType="Button" BasedOn="{StaticResource ZsSetupPart}">
                <Setter Property="BorderBrush" Value="{ThemeResource ZsBorder}" />
                <Setter Property="BorderThickness" Value="1,0,0,0" />
            </Style>
            <!-- A round button of the bottom bar. -->
            <Style x:Key="ZsPill" TargetType="Button" BasedOn="{StaticResource ZsButtonBase}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>
            <Style x:Key="ZsFlatPill" TargetType="Button" BasedOn="{StaticResource ZsPill}">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <!-- One part of the setup group. -->
            <Style x:Key="ZsSetupPart" TargetType="Button" BasedOn="{StaticResource ZsButtonBase}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
