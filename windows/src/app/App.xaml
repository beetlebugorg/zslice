                    <SolidColorBrush x:Key="ZsFg" Color="#EBFFFFFF" />
                    <SolidColorBrush x:Key="ZsDim" Color="#8CFFFFFF" />
                    <SolidColorBrush x:Key="ZsAccent" Color="#1C5FB0" />
                    <SolidColorBrush x:Key="ZsAccentText" Color="#78AEED" />
