                    <SolidColorBrush x:Key="ZsView" Color="#1D1D20" />
                    <SolidColorBrush x:Key="ZsFloat" Color="#E02D2D2D" />
                    <SolidColorBrush x:Key="ZsPopover" Color="#F528282C" />
