<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZSlice.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" AllowDrop="True" Background="#F6F7F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The tool row. -->
        <Grid x:Name="ToolRow" Grid.Row="0" Height="48" Background="#FFFFFF" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="zslice" VerticalAlignment="Center"
                       FontSize="15" FontWeight="SemiBold" Margin="0,0,16,0" />
            <Button x:Name="OpenButton" Grid.Column="1" Content="Open" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Open a model (Ctrl+O)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </Button.KeyboardAccelerators>
            </Button>
            <TextBlock x:Name="FileName" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="#5B6168" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- The core draws into this panel. The XAML chrome floats over it. -->
        <Grid Grid.Row="1">
            <SwapChainPanel x:Name="ViewPanel" IsTabStop="True" />

            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="6" IsHitTestVisible="False">
                <TextBlock Text="Open a model to slice it" FontSize="20" HorizontalAlignment="Center" />
                <TextBlock Text="STL or 3MF. Drop a file here, or press Ctrl+O."
                           Foreground="#5B6168" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- The plates: as the dock of the other apps. -->
            <Border x:Name="PlateBar" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,14" Padding="6,4" Background="#F2FFFFFF"
                    BorderBrush="#DDE0E4" BorderThickness="1" CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="PlatePrev" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="The plate before ([)">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                    <TextBlock x:Name="PlateName" VerticalAlignment="Center" Margin="8,0" FontSize="13" />
                    <Button x:Name="PlateNext" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="The next plate (])">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                    <Button x:Name="PlateAll" Content="All" Background="Transparent" BorderThickness="0"
                            Visibility="Collapsed" ToolTipService.ToolTip="Show all plates (Home). F shows the active plate." />
                    <Button x:Name="PlateAdd" Content="+ Plate" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="A new plate with the settings of this plate" />
                    <Button x:Name="PlateRemove" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Remove this plate">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="LayerCard" Visibility="Collapsed" HorizontalAlignment="Right"
                    VerticalAlignment="Stretch" Margin="0,16,16,16" Padding="8,12"
                    Background="#F2FFFFFF" BorderBrush="#DDE0E4" BorderThickness="1" CornerRadius="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LayerText" Grid.Row="0" HorizontalAlignment="Center" FontSize="12" />
                    <Slider x:Name="LayerSlider" Grid.Row="1" Orientation="Vertical" Minimum="1"
                            StepFrequency="1" SmallChange="1" LargeChange="10"
                            HorizontalAlignment="Center" IsThumbToolTipEnabled="False" />
                </Grid>
            </Border>
        </Grid>

        <!-- The status bar. -->
        <Grid Grid.Row="2" Height="30" Background="#FFFFFF" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="#3C4148" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="SliceProgress" Grid.Column="1" VerticalAlignment="Center"
                         Minimum="0" Maximum="1" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
