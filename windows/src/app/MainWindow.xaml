<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZSlice.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" AllowDrop="True" Background="{ThemeResource ZsView}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The header: the file, the search in the middle, then the setup
             group and three icons, as web/app/index.html. -->
        <Grid x:Name="ToolRow" Grid.Row="0" MinHeight="47" Padding="7,6" ColumnSpacing="6"
              Background="{ThemeResource ZsHeader}" BorderBrush="{ThemeResource ZsBorder}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Style="{StaticResource ZsHeaderIcon}" AutomationProperties.Name="Open or add models"
                        ToolTipService.ToolTip="Open a model, or add models to this plate (Ctrl+O opens)">
                    <Path Width="16" Height="16" Stroke="{ThemeResource ZsFg}" StrokeThickness="1.2"
                          Data="M3 2.5h7l3 3v8H3z M9.5 2.5v3.5h3.5 M5.5 8.5h5 M5.5 11h5" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </Button.KeyboardAccelerators>
                </Button>
                <TextBlock x:Name="FileName" Text="zslice" VerticalAlignment="Center" Margin="6,0"
                           FontWeight="Bold" Foreground="{ThemeResource ZsFg}" MaxWidth="300" TextWrapping="Wrap" LineHeight="16" />
                <!-- The filament list of the tools. The setup group opens the
                     filaments, so this button does not show. -->
                <DropDownButton x:Name="FilamentButton" AutomationProperties.Name="Filaments" Visibility="Collapsed" />
            </StackPanel>

            <!-- The search of settings and actions. -->
            <Grid x:Name="SearchField" Grid.Column="1" Width="380" Height="32" Padding="10,0,6,0" ColumnSpacing="6"
                  CornerRadius="9" BorderThickness="1" BorderBrush="{ThemeResource ZsBorder}" Background="{ThemeResource ZsButton}"
                  ToolTipService.ToolTip="Search settings and actions (/). Change a setting right in the results, and watch the slice.">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Width="15" Height="15" Opacity="0.7" VerticalAlignment="Center" Stroke="{ThemeResource ZsFg}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M11.8 7a4.8 4.8 0 1 1-9.6 0a4.8 4.8 0 1 1 9.6 0z M10.6 10.6l3.4 3.4" />
                <TextBox x:Name="HeaderSearch" Grid.Column="1" PlaceholderText="Search settings and actions"
                         AutomationProperties.Name="Search settings and actions" BorderThickness="0" Padding="0,5,0,0"
                         MinHeight="28" Background="Transparent" VerticalAlignment="Center" FontSize="14">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>
                <Border x:Name="SearchKey" Grid.Column="2" BorderThickness="1" BorderBrush="{ThemeResource ZsLine}" CornerRadius="4"
                        Padding="5,0" Opacity="0.7" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="/" FontSize="11.5" />
                </Border>
                <Button x:Name="SearchClose" Grid.Column="3" Width="26" Height="26" MinWidth="0" Padding="0" Opacity="0.75" Background="Transparent"
                        Visibility="Collapsed" Content="×" FontSize="16" VerticalAlignment="Center"
                        AutomationProperties.Name="Close the search" ToolTipService.ToolTip="Close the search (Esc)" />
                <Button x:Name="SearchUndock" Grid.Column="4" Width="26" Height="26" MinWidth="0" Padding="0" Opacity="0.7" Background="Transparent"
                        VerticalAlignment="Center" AutomationProperties.Name="Undock the search"
                        ToolTipService.ToolTip="Undock the search: a card over the view that you can move and resize">
                    <Path Width="15" Height="15" Stroke="{ThemeResource ZsFg}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Data="M2.5 3.5h11v9h-11zM2.5 6.5h11" />
                </Button>
            </Grid>
            <!-- The search is a card or on a rail: the header opens it. -->
            <Button x:Name="SearchOpen" Grid.Column="1" Height="32" Padding="10,0" Visibility="Collapsed" HorizontalAlignment="Center"
                    AutomationProperties.Name="Search settings and actions"
                    ToolTipService.ToolTip="Search settings and actions (/). Change a setting right in the results, and watch the slice.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="15" Height="15" Opacity="0.7" VerticalAlignment="Center" Stroke="{ThemeResource ZsFg}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M11.8 7a4.8 4.8 0 1 1-9.6 0a4.8 4.8 0 1 1 9.6 0z M10.6 10.6l3.4 3.4" />
                    <TextBlock Text="Search" VerticalAlignment="Center" />
                    <Border BorderThickness="1" BorderBrush="{ThemeResource ZsLine}" CornerRadius="4" Padding="5,0" Opacity="0.8" VerticalAlignment="Center">
                        <TextBlock Text="/" FontSize="11.5" />
                    </Border>
                </StackPanel>
            </Button>

            <StackPanel x:Name="HeaderEnd" Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- The printer, the filament, and the quality, as one group. -->
                <Border x:Name="SetupGroup" BorderThickness="1" BorderBrush="{ThemeResource ZsBorder}" CornerRadius="9">
                    <StackPanel x:Name="SetupRow" Orientation="Horizontal" />
                </Border>
                <StackPanel x:Name="PrintersHost" Orientation="Horizontal" />
                <ToggleButton x:Name="SettingsToggle" Width="34" Height="32" Padding="0" CornerRadius="6"
                              AutomationProperties.Name="All settings" ToolTipService.ToolTip="All settings (N)">
                    <Path Width="16" Height="16" Stroke="{ThemeResource ZsFg}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M2.5 4.5h7M12.5 4.5h1M2.5 11.5h2M7.5 11.5h6M11 3v3M6 10v3" />
                </ToggleButton>
                <Button x:Name="MainMenuButton" Style="{StaticResource ZsHeaderIcon}" AutomationProperties.Name="Main menu"
                        ToolTipService.ToolTip="Main menu">
                    <Path Width="16" Height="16" Stroke="{ThemeResource ZsFg}" StrokeThickness="1.3" Data="M3 4.5h10M3 8h10M3 11.5h10" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="MainMenu" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The core draws into this panel. The XAML chrome floats over it. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The settings: built from the descriptions of the core. -->
            <Border x:Name="SettingsPane" Grid.Column="1" Width="420" Visibility="Collapsed"
                    Background="{ThemeResource ZsBg}" BorderBrush="{ThemeResource ZsPopoverBorder}" BorderThickness="1,0,0,0">
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Settings for" VerticalAlignment="Center" Foreground="{ThemeResource ZsDim}" />
                        <ComboBox x:Name="SettingsScope" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Settings for"
                                  ToolTipService.ToolTip="What a change here is for: this print (all parts on the plate), your global settings (all prints, under the quality profile), or one part (the values of the print, and its own changes on top)." />
                    </Grid>
                    <TextBox x:Name="SettingsSearch" AutomationProperties.Name="Search settings" ToolTipService.ToolTip="The defaults for all prints. Changes for one part are in the Selected page." Grid.Row="0" PlaceholderText="Search settings" />
                    <Grid Grid.Row="2" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SettingsBack" AutomationProperties.Name="Back" Background="Transparent" BorderThickness="0"
                                Visibility="Collapsed" ToolTipService.ToolTip="Back to the column before">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        </Button>
                        <TextBlock x:Name="SettingsCrumbs" Grid.Column="1" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="SettingsCrumb" Visibility="Collapsed" />
                    </Grid>
                    <!-- The bar of the layer profile in edit. -->
                    <Border x:Name="ProfileBar" Grid.Row="3" Visibility="Collapsed" Padding="10,8" CornerRadius="8" BorderThickness="1"
                            Background="{ThemeResource ZsFloat}" BorderBrush="{ThemeResource ZsLine}">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileTitle" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                <TextBlock x:Name="ProfileNote" FontSize="11.5" TextWrapping="WrapWholeWords" Foreground="{ThemeResource ZsDim}" />
                            </StackPanel>
                            <Button x:Name="ProfileRename" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                    AutomationProperties.Name="Rename the profile" ToolTipService.ToolTip="Rename the profile">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                <Button.Flyout>
                                    <Flyout x:Name="ProfileRenameFlyout">
                                        <TextBox x:Name="ProfileRenameBox" Width="220" AutomationProperties.Name="The name of the profile" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="ProfileDelete" Grid.Column="2" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                    AutomationProperties.Name="Delete the profile" ToolTipService.ToolTip="Delete the profile and all its changes">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                            </Button>
                            <Button x:Name="ProfileDone" Grid.Column="3" Content="Done" VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Stop the edit of this profile. Changes then go to all prints again." />
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SettingsList" Spacing="2" Padding="0,0,14,0" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <SwapChainPanel x:Name="ViewPanel" IsTabStop="True" />
            <SwapChainPanel x:Name="Layer2DPanel" IsTabStop="True" Visibility="Collapsed" />

            <!-- An empty plate: a small Open button on the plate. It moves
                 with the plate. -->
            <Canvas x:Name="EmptyHint">
                <Button x:Name="EmptyOpen" Content="Open a model" MinHeight="28" Height="28" Padding="12,0" CornerRadius="14"
                        FontSize="12.5" Background="{ThemeResource ZsPopover}" BorderBrush="{ThemeResource ZsPopoverBorder}" BorderThickness="1"
                        ToolTipService.ToolTip="Open a model on this plate. You can also drop an STL or 3MF file on the view." />
            </Canvas>

            <!-- The work bar: 2 px at the top edge of the view, and what runs. -->
            <ProgressBar x:Name="WorkBar" Canvas.ZIndex="45" Height="2" MinHeight="2" VerticalAlignment="Top" Minimum="0" Maximum="1"
                         Background="Transparent" Foreground="{ThemeResource ZsAccent}" CornerRadius="0" Opacity="0" IsHitTestVisible="False">
                <ProgressBar.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </ProgressBar.OpacityTransition>
            </ProgressBar>
            <TextBlock x:Name="WorkText" Canvas.ZIndex="45" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,64,0"
                       FontSize="11.5" Foreground="{ThemeResource ZsFg}" Opacity="0" IsHitTestVisible="False">
                <TextBlock.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </TextBlock.OpacityTransition>
            </TextBlock>

            <!-- A short note, over the bottom bar. -->
            <Border x:Name="ToastCard" Canvas.ZIndex="60" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,84" Padding="16,8" CornerRadius="18" Background="#EB242424"
                    MaxWidth="640" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="#FFFFFF" TextWrapping="WrapWholeWords" />
            </Border>

            <!-- Slicing, or reading a file. -->
            <Border x:Name="BusyPill" Canvas.ZIndex="50" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,64,0" Padding="12,4" CornerRadius="13" Background="#EB242424"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="BusyText" Foreground="#FFFFFF" FontSize="12.5" />
            </Border>

            <!-- The sign of the 2D view. A click shows the 3D view. -->
            <Button x:Name="ViewSign" Content="2D view" Canvas.ZIndex="50" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,10,0,0" Padding="12,3" MinHeight="0" CornerRadius="13" FontSize="12.5" FontWeight="SemiBold"
                    Background="{ThemeResource ZsFloat}" Visibility="Collapsed"
                    ToolTipService.ToolTip="The 2D layer view: one layer from the top. Click here, or press 2, for the 3D view." />

            <!-- One bar at the bottom, the full width of the view: the plates,
                 the history, the replay of the print, and the print. -->
            <Grid x:Name="Dock" Canvas.ZIndex="40" VerticalAlignment="Bottom" Padding="12,4" ColumnSpacing="10" RowSpacing="2"
                  Background="{ThemeResource ZsPopover}" BorderBrush="{ThemeResource ZsDockLine}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="PlateBar" Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="PlatePrev" Style="{StaticResource ZsFlatPill}" Content="&#x2039;" AutomationProperties.Name="The plate before"
                            ToolTipService.ToolTip="The plate before ([)" />
                    <TextBlock x:Name="PlateName" VerticalAlignment="Center" Margin="6,0" FontSize="12.5" />
                    <Button x:Name="PlateNext" Style="{StaticResource ZsFlatPill}" Content="&#x203A;" AutomationProperties.Name="The next plate"
                            ToolTipService.ToolTip="The next plate (])" />
                    <Button x:Name="PlateAll" Style="{StaticResource ZsPill}" Content="All" Visibility="Collapsed"
                            ToolTipService.ToolTip="Show all plates (Home). F shows the active plate." />
                    <Button x:Name="PlateAdd" Style="{StaticResource ZsPill}" Content="+ Plate"
                            ToolTipService.ToolTip="Add an empty plate after the others" />
                    <Button x:Name="PlateRemove" Style="{StaticResource ZsPill}" Content="&#xD7;" AutomationProperties.Name="Remove this plate"
                            ToolTipService.ToolTip="Remove this plate" />
                </StackPanel>

                <!-- Undo, redo, and the history behind a button. A number on
                     the button counts the changes since the last open or save. -->
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            BorderBrush="{ThemeResource ZsLine}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                    <Button x:Name="UndoButton" Style="{StaticResource ZsFlatPill}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="14" IsEnabled="False"
                            AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                        <Path Width="18" Height="18" Stroke="{ThemeResource ZsFg}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Data="M6.5 3.5 3 7l3.5 3.5M3 7h7.5a4.5 4.5 0 0 1 0 9H8" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Z" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource ZsFlatPill}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="14" IsEnabled="False"
                            AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo (Ctrl+Shift+Z)">
                        <Path Width="18" Height="18" Stroke="{ThemeResource ZsFg}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Data="M11.5 3.5 15 7l-3.5 3.5M15 7H7.5a4.5 4.5 0 0 0 0 9H10" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Y" />
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Grid>
                        <Button x:Name="HistoryButton" Style="{StaticResource ZsFlatPill}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="14"
                                AutomationProperties.Name="History" ToolTipService.ToolTip="History (Ctrl+H)">
                            <Path Width="18" Height="18" Stroke="{ThemeResource ZsFg}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M3.2 9a5.8 5.8 0 1 0 1.7-4.1M4.9 1.9v3h3M9 5.8V9l2.3 1.5" />
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="H" />
                            </Button.KeyboardAccelerators>
                            <Button.Flyout>
                                <Flyout x:Name="HistoryFlyout" Placement="TopEdgeAlignedLeft">
                                    <StackPanel Width="416" Spacing="4">
                                        <Grid ColumnSpacing="8" Padding="2,0,0,4" BorderBrush="{ThemeResource ZsLine}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="History" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="HistorySum" Grid.Column="1" FontSize="12" Foreground="{ThemeResource ZsDim}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Button x:Name="HistoryClose" Grid.Column="2" Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" Content="&#xD7;" FontSize="16"
                                                    AutomationProperties.Name="Close the history" ToolTipService.ToolTip="Close the history (Esc)" />
                                        </Grid>
                                        <ScrollViewer x:Name="HistoryScroll" IsTabStop="True" MaxHeight="500" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="HistoryList" Spacing="2" Padding="0,0,12,0" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Border x:Name="HistoryCount" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0" MinWidth="15" Height="15" Padding="4,0"
                                CornerRadius="8" Background="{ThemeResource ZsAccent}" IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock x:Name="HistoryCountText" FontSize="10" FontWeight="Bold" LineHeight="15" Foreground="#FFFFFF" TextAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- The replay of the print. -->
                <Grid x:Name="ScrubRow" Grid.Column="2" Grid.Row="0" ColumnSpacing="10" Padding="8,0,0,0"
                      BorderBrush="{ThemeResource ZsLine}" BorderThickness="1,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Grid.Column="0" Width="30" Height="28" MinHeight="0" Padding="0"
                            AutomationProperties.Name="Replay the print" ToolTipService.ToolTip="Replay the print">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="12" />
                    </Button>
                    <ComboBox x:Name="SpeedBox" Grid.Column="1" AutomationProperties.Name="The replay speed" MinWidth="70" MinHeight="28"
                              Height="28" Padding="10,2,0,2" Background="{ThemeResource ZsButton}" BorderThickness="0" FontSize="13" VerticalAlignment="Center" ToolTipService.ToolTip="The replay speed" />
                    <Slider x:Name="ScrubSlider" Grid.Column="2" AutomationProperties.Name="The time in the layer" Foreground="{ThemeResource ZsAccent}"
                            Minimum="0" Maximum="1" StepFrequency="0.001" Value="1"
                            VerticalAlignment="Center" IsThumbToolTipEnabled="False" />
                    <TextBlock x:Name="ScrubText" Grid.Column="3" VerticalAlignment="Center" FontSize="12" MinWidth="130" />
                </Grid>

                <!-- The print: its time, its details, and Export. -->
                <Grid x:Name="DockSummary" Grid.Column="3" Grid.Row="0" ColumnSpacing="10" Padding="12,0,0,0"
                      BorderBrush="{ThemeResource ZsLine}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SummaryButton" Grid.Column="0" Background="Transparent" Padding="8,4" CornerRadius="8" VerticalAlignment="Center"
                            HorizontalContentAlignment="Left" AutomationProperties.Name="The details of the print"
                            ToolTipService.ToolTip="The details of the print">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SummaryTime" FontSize="18.5" FontWeight="Bold" />
                            <Border x:Name="SummaryBadge" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="7,1"
                                    CornerRadius="9" Background="#B42318" Visibility="Collapsed">
                                <TextBlock x:Name="SummaryBadgeText" Text="Check" FontSize="11" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock x:Name="SummaryDetail" Grid.Row="1" Grid.ColumnSpan="2" FontSize="11.5" Foreground="{ThemeResource ZsDim}" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="SummaryFlyout" Placement="TopEdgeAlignedRight">
                                <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Width="296" Spacing="6">
                                        <StackPanel x:Name="SummaryCamera" Spacing="4" Visibility="Collapsed">
                                            <Border x:Name="SummaryCameraBox" />
                                            <TextBlock x:Name="SummaryCameraLine" FontSize="12" TextWrapping="WrapWholeWords" Foreground="{ThemeResource ZsDim}" />
                                            <TextBlock x:Name="SummaryCameraNote" FontSize="12" TextWrapping="WrapWholeWords" Foreground="{ThemeResource ZsDim}" Visibility="Collapsed" />
                                        </StackPanel>
                                        <StackPanel x:Name="SummaryFacts" Spacing="4" />
                                        <Border x:Name="SummaryFilaments" />
                                        <TextBlock x:Name="SummaryTook" FontSize="12" Foreground="{ThemeResource ZsDim}" />
                                        <Border x:Name="SummaryWarnBox" Padding="8,6" CornerRadius="6" Background="#B42318" Visibility="Collapsed">
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="SummaryWarn" FontSize="12.5" Foreground="#FFFFFF" TextWrapping="WrapWholeWords" />
                                                <StackPanel x:Name="SummaryWarnButtons" Orientation="Horizontal" Spacing="4" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel x:Name="SummaryRefine" Spacing="4" Visibility="Collapsed" />
                                        <TextBlock x:Name="SummaryProject" FontSize="12" Margin="0,2,0,0" TextWrapping="WrapWholeWords"
                                                   Foreground="{ThemeResource ZsDim}" Visibility="Collapsed" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <StackPanel x:Name="ExportGroup" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" MinWidth="150" Background="Transparent">
                        <Button x:Name="ExportButton" Content="Export G-code&#x2026;" MinWidth="124" Height="32" Padding="14,0" CornerRadius="6"
                                Style="{StaticResource ZsSuggested}" IsEnabled="False" />
                        <Button x:Name="SendMenuButton" Width="28" Height="32" Padding="0" CornerRadius="0,6,6,0"
                                Style="{StaticResource ZsSuggested}" Visibility="Collapsed" AutomationProperties.Name="More"
                                ToolTipService.ToolTip="More: upload, export all plates, or save a project">
                            <FontIcon Glyph="&#xE70D;" FontSize="10" />
                        </Button>
                    </StackPanel>
                    <ProgressBar x:Name="SliceProgress" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Minimum="0" Maximum="1"
                                 Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <!-- The range of the colors, or the gaps of the layer. -->
            <Border x:Name="LegendCard" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="62,18,0,0" Padding="10,3" Background="{ThemeResource ZsFloat}" CornerRadius="10">
                <TextBlock x:Name="LegendText" FontSize="12" />
            </Border>

            <!-- The layers: a slider with two knobs on the view, with no card. -->
            <Grid x:Name="LayerCard" Visibility="Collapsed" Width="30" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Margin="0,140,14,94" Background="Transparent">
                <!-- The slider holds the top layer for the code. The rail
                     below draws it. -->
                <Slider x:Name="LayerSlider" Visibility="Collapsed" Orientation="Vertical" Minimum="1" StepFrequency="1"
                        SmallChange="1" LargeChange="10" IsThumbToolTipEnabled="False" />
                <Border x:Name="LayerTrough" Width="4" Margin="0,9" CornerRadius="2" HorizontalAlignment="Center"
                        Background="{ThemeResource ZsTrough}" IsHitTestVisible="False" />
                <!-- The marks of the layer ranges with changes. -->
                <Canvas x:Name="LayerMarks" Canvas.ZIndex="1" />
                <Canvas x:Name="LayerCanvas" IsHitTestVisible="False">
                    <Border x:Name="LayerHighlight" Canvas.Left="13" Width="4" CornerRadius="2" Background="{ThemeResource ZsAccent}" />
                    <Ellipse x:Name="LayerLoShade" Canvas.Left="5" Width="20" Height="20" Fill="#40000000" />
                    <Ellipse x:Name="LayerLoKnob" Canvas.Left="6" Width="18" Height="18" Fill="#FFFFFF" Stroke="#1F000000" StrokeThickness="1" />
                    <Ellipse x:Name="LayerHiShade" Canvas.Left="5" Width="20" Height="20" Fill="#40000000" />
                    <Ellipse x:Name="LayerHiKnob" Canvas.Left="6" Width="18" Height="18" Fill="#FFFFFF" Stroke="#1F000000" StrokeThickness="1" />
                    <Border x:Name="LayerHiBubble" Padding="6,1" CornerRadius="6" Background="#EB242424">
                        <TextBlock x:Name="LayerText" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                    <Border x:Name="LayerLoBubble" Padding="6,1" CornerRadius="6" Background="#EB242424" Visibility="Collapsed">
                        <TextBlock x:Name="LayerLoText" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                </Canvas>
            </Grid>

            <!-- The tools: V M R S G T P E, built in MainWindow.Tools.cpp. -->
            <StackPanel x:Name="ToolStrip" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="10,18,0,0" Padding="4" Spacing="2" Background="{ThemeResource ZsFloat}" CornerRadius="10" />

            <!-- The cards float over the view, beside what they describe. -->
            <Canvas x:Name="CardLayer">
                <!-- The results of the search (MainWindow.Search.cpp). The
                     view keeps the mouse around them. -->
                <Border x:Name="SearchBox" Canvas.ZIndex="70" Width="560" Visibility="Collapsed" CornerRadius="14" BorderThickness="1"
                        Background="{ThemeResource ZsPopover}" BorderBrush="{ThemeResource ZsPopoverBorder}"
                        AutomationProperties.Name="Search settings and actions">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="SearchHead" Padding="10,8,10,8" ColumnSpacing="8" Background="Transparent"
                              BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ZsLine}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="SearchGrip" Width="10" Height="18" Opacity="0.45" VerticalAlignment="Center" Fill="{ThemeResource ZsFg}"
                                  Data="M1 3a1.2 1.2 0 1 1 2.4 0a1.2 1.2 0 1 1-2.4 0z M6 3a1.2 1.2 0 1 1 2.4 0a1.2 1.2 0 1 1-2.4 0z M1 9a1.2 1.2 0 1 1 2.4 0a1.2 1.2 0 1 1-2.4 0z M6 9a1.2 1.2 0 1 1 2.4 0a1.2 1.2 0 1 1-2.4 0z M1 15a1.2 1.2 0 1 1 2.4 0a1.2 1.2 0 1 1-2.4 0z M6 15a1.2 1.2 0 1 1 2.4 0a1.2 1.2 0 1 1-2.4 0z"
                                  ToolTipService.ToolTip="Drag to move the search. Double-click: back to its first place." />
                            <TextBox x:Name="SearchEntry" Grid.Column="2" PlaceholderText="Search settings and actions"
                                     AutomationProperties.Name="Search settings and actions" BorderThickness="0" Padding="0,5,0,0"
                                     MinHeight="28" Background="Transparent" VerticalAlignment="Center" FontSize="16">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <StackPanel x:Name="SearchHeadPins" Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                        </Grid>
                        <Grid x:Name="SearchPinRow" Grid.Row="1" Padding="12,10,12,2">
                            <StackPanel x:Name="SearchPins" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" />
                        </Grid>
                        <ScrollViewer x:Name="SearchScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SearchList" Padding="6" />
                        </ScrollViewer>
                        <Border x:Name="SearchResize" Grid.Row="2" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="Transparent" ToolTipService.ToolTip="Drag to change the size">
                            <Path Width="14" Height="14" Opacity="0.5" Stroke="{ThemeResource ZsFg}" StrokeThickness="1.2" Data="M13 3 3 13M13 8l-5 5" />
                        </Border>
                    </Grid>
                </Border>
                <Border x:Name="LineCard" Width="340" Visibility="Collapsed" Padding="12"
                        Background="{ThemeResource ZsPopover}" BorderBrush="{ThemeResource ZsPopoverBorder}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <Grid x:Name="LineCardHead">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LineTitle" FontWeight="Bold" VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="LineClose" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                    Padding="6" AutomationProperties.Name="Close the line card">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LinePlanned" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="planned" FontSize="11" Foreground="{ThemeResource ZsDim}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LineReal" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="real" FontSize="11" Foreground="{ThemeResource ZsDim}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LineFlow" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="flow" FontSize="11" Foreground="{ThemeResource ZsDim}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LineNote" TextWrapping="WrapWholeWords" FontSize="12" Foreground="#B45309" />
                        <TextBlock x:Name="LineNozzle" TextWrapping="WrapWholeWords" FontSize="12" Opacity="0.85" Visibility="Collapsed" />
                        <TextBlock x:Name="LineSize" TextWrapping="WrapWholeWords" FontSize="12" Foreground="{ThemeResource ZsDim}" />
                        <Grid ColumnSpacing="6" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Background="Transparent"
                                        ToolTipService.ToolTip="A filament for the body of this line on its layer only: the lines joined to it. The paint of the part keeps it.">
                                <TextBlock Text="Filament" FontSize="13" />
                                <TextBlock Text="This part of the layer" FontSize="11" Opacity="0.7" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <VariableSizedWrapGrid x:Name="LineFilamentChips" Grid.Column="1" Orientation="Horizontal" ItemWidth="30" ItemHeight="30"
                                                   MaximumRowsOrColumns="6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="LineExtend" Visibility="Collapsed" />
                        <!-- The support mark of the user at this line. -->
                        <StackPanel x:Name="LineMark" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Support you added" FontWeight="SemiBold" FontSize="12" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LineMarkKind" HorizontalAlignment="Stretch" AutomationProperties.Name="The kind of support">
                                    <x:String>Grid</x:String>
                                    <x:String>Tree</x:String>
                                    <x:String>Bridge pad</x:String>
                                    <x:String>Block (no support)</x:String>
                                </ComboBox>
                                <NumberBox x:Name="LineMarkRadius" Grid.Column="1" Minimum="0.5" Maximum="30" SmallChange="0.5"
                                           AutomationProperties.Name="The radius of the mark in millimeters"
                                           ToolTipService.ToolTip="The radius of the area of the mark, mm" />
                                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Foreground="{ThemeResource ZsDim}" />
                                <Button x:Name="LineMarkRemove" Grid.Column="3" Content="Remove" Foreground="#C01C28" />
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="LineSettings" Spacing="4" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ToggleButton x:Name="LineFade" Content="Fade the others"
                                          ToolTipService.ToolTip="Show this line solid, and the other lines as faint ghosts" />
                            <Button x:Name="LineAll" Content="All settings…" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="All the settings of this line" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="LineSkip" Content="Don't print this line" Background="Transparent" BorderThickness="0"
                                    FontSize="12" Padding="6,4"
                                    ToolTipService.ToolTip="Take this line out of the print (Delete). The edit stays, and applies again to a new slice that makes the same line." />
                            <Button x:Name="LineLess" Content="−10 % plastic" Background="Transparent" BorderThickness="0"
                                    FontSize="12" Padding="6,4" ToolTipService.ToolTip="This line with 10 % less plastic" />
                            <Button x:Name="LineMore" Content="+10 % plastic" Background="Transparent" BorderThickness="0"
                                    FontSize="12" Padding="6,4" ToolTipService.ToolTip="This line with 10 % more plastic, for a gap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="PartCard" Width="320" Visibility="Collapsed" Padding="12"
                        Background="{ThemeResource ZsPopover}" BorderBrush="{ThemeResource ZsPopoverBorder}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <Grid x:Name="PartCardHead">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PartTitle" FontWeight="Bold" VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="PartClose" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                    Padding="6" AutomationProperties.Name="Close the part card">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="PartFacts" FontSize="12" Foreground="{ThemeResource ZsDim}" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="PartFloatNote" FontSize="12" Foreground="#B45309" TextWrapping="WrapWholeWords" Visibility="Collapsed" />
                        <StackPanel x:Name="PartSingle" Spacing="6">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Scale" VerticalAlignment="Center" />
                                <TextBox x:Name="PartScale" Grid.Column="1" AutomationProperties.Name="Scale in percent" />
                                <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Foreground="{ThemeResource ZsDim}" />
                            </Grid>
                            <Grid ColumnSpacing="4" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="PartDuplicate" Content="Duplicate" HorizontalAlignment="Stretch" />
                                <Button x:Name="PartSplit" Grid.Column="1" Content="Split" HorizontalAlignment="Stretch" />
                                <DropDownButton x:Name="PartCut" Grid.Row="1" Content="Cut…" HorizontalAlignment="Stretch">
                                    <DropDownButton.Flyout>
                                        <Flyout x:Name="PartCutFlyout">
                                            <StackPanel Spacing="8" Width="240">
                                                <Slider x:Name="CutHeight" Header="Height (mm)" StepFrequency="0.1" />
                                                <CheckBox x:Name="CutFlip" Content="Flip the top part onto the bed" IsChecked="True" />
                                                <NumberBox x:Name="CutPegs" Header="Pegs to line up the parts (0: none)" Minimum="0" Maximum="4" Value="2"
                                                           ToolTipService.ToolTip="Holes in both cut faces, and pegs that print as parts of the plate."
                                                           SpinButtonPlacementMode="Inline" />
                                                <NumberBox x:Name="CutPegSize" Header="Peg diameter (mm)" Minimum="2" Maximum="20" SmallChange="0.5"
                                                           Value="5" SpinButtonPlacementMode="Inline" />
                                                <Button x:Name="CutGo" Content="Cut" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button x:Name="PartBest" Grid.Row="1" Grid.Column="1" Content="Best orientation"
                                        HorizontalAlignment="Stretch" />
                                <Button x:Name="PartLess" Grid.Row="2" Content="Less support" HorizontalAlignment="Stretch" />
                                <Button x:Name="PartReset" Grid.Row="2" Grid.Column="1" Content="Reset" HorizontalAlignment="Stretch" />
                            </Grid>
                            <!-- One part at a time: the place of the part in the print order. -->
                            <Grid x:Name="PartOrderRow" ColumnSpacing="6" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PartOrderText" FontSize="12.5" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                                <Button x:Name="PartEarlier" Grid.Column="1" Content="Print earlier" FontSize="12" MinHeight="28" Padding="9,3"
                                        ToolTipService.ToolTip="Print this part before the part before it in the plate list" />
                                <Button x:Name="PartLater" Grid.Column="2" Content="Print later" FontSize="12" MinHeight="28" Padding="9,3"
                                        ToolTipService.ToolTip="Print this part after the part after it in the plate list" />
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Make" VerticalAlignment="Center" />
                                <NumberBox x:Name="PartMakeCount" Grid.Column="1" Minimum="2" Maximum="10000" Value="10"
                                           SpinButtonPlacementMode="Compact" AutomationProperties.Name="How many in all" />
                                <Button x:Name="PartMake" Grid.Column="2" Content="in all" />
                            </Grid>
                            <!-- The settings that the part has of its own. -->
                            <StackPanel x:Name="PartOwnSettings" Spacing="4" Visibility="Collapsed" />
                            <!-- The settings of a Cura project and the modifier volumes. -->
                            <StackPanel x:Name="PartFileBox" Spacing="2" Visibility="Collapsed">
                                <TextBlock Text="Its volumes and file settings" FontWeight="SemiBold" FontSize="12" />
                                <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="PartFileText" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" Foreground="{ThemeResource ZsDim}" />
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="PartAddSetting" Content="+ Add a setting for this part" Background="Transparent" BorderThickness="0"
                                Foreground="{ThemeResource ZsAccentText}" FontSize="12" Padding="0,2" MinHeight="24"
                                ToolTipService.ToolTip="Search the settings that a part can have of its own" />
                        <Grid ColumnSpacing="4" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button x:Name="PartsDuplicate" Content="Duplicate" Visibility="Collapsed" HorizontalAlignment="Stretch" />
                            <Button x:Name="PartsArrange" Grid.Column="1" Content="Arrange" Visibility="Collapsed" HorizontalAlignment="Stretch" />
                            <Button x:Name="PartNewPlate" Grid.Row="1" Content="To a new plate" HorizontalAlignment="Stretch" />
                            <Button x:Name="PartRemove" Grid.Row="1" Grid.Column="1" Content="Remove" HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="GapCard" Width="320" Visibility="Collapsed" Padding="12"
                        Background="{ThemeResource ZsPopover}" BorderBrush="{ThemeResource ZsPopoverBorder}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GapTitle" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button x:Name="GapClose" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                    Padding="6" AutomationProperties.Name="Close the gap card">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="GapFacts" FontSize="12" Foreground="{ThemeResource ZsDim}" TextWrapping="WrapWholeWords" />
                        <StackPanel x:Name="GapAdvice" Spacing="6" />
                    </StackPanel>
                </Border>

                <Border x:Name="MeasureCard" Visibility="Collapsed" Padding="10,6" IsHitTestVisible="False" MaxWidth="520"
                        Background="{ThemeResource ZsPopover}" BorderBrush="{ThemeResource ZsPopoverBorder}" BorderThickness="1" CornerRadius="8">
                    <TextBlock x:Name="MeasureText" FontSize="12" TextWrapping="WrapWholeWords" />
                </Border>
            </Canvas>
        </Grid>

    </Grid>
</Window>
