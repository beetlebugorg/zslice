<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- CppWinRT.props comes before Cpp.Default.props: it wires the WinUI markup
       passes into the native build. PackageReference imports the .targets
       and not this .props. The layout follows Lookout Marine. See
       docs/references/libraries.md. -->
  <Import Project="$(UserProfile)\.nuget\packages\microsoft.windows.cppwinrt\3.0.260715.1\build\native\Microsoft.Windows.CppWinRT.props" Condition="Exists('$(UserProfile)\.nuget\packages\microsoft.windows.cppwinrt\3.0.260715.1\build\native\Microsoft.Windows.CppWinRT.props')" />

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTUsePrefixes>true</CppWinRTUsePrefixes>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{5D0B7E2A-3C41-4F6E-8A19-2E7C9B14D6F3}</ProjectGuid>
    <ProjectName>ZSlice</ProjectName>
    <RootNamespace>ZSlice</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackage>false</AppxPackage>
    <AppContainerApplication>false</AppContainerApplication>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- The NuGet task of Visual Studio 2022 fails on a native project with
         PackageReference. The restore writes the imports that the build uses. -->
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <!-- The toolset of the installed Visual Studio: v143 for 2022, v145 for 2026. -->
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="Exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <GenerateManifest>true</GenerateManifest>
    <!-- The core of this platform, from windows\build-core.ps1. -->
    <ZsCoreDir>$(MSBuildThisFileDirectory)..\zig-out\windows-$(Platform.ToLower())</ZsCoreDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- The markup passes write <Name>.xaml.g.h into $(IntDir), in the
           layout of the sources. -->
      <AdditionalIncludeDirectories>$(IntDir);$(IntDir)src\app;$(MSBuildThisFileDirectory);$(MSBuildThisFileDirectory)src\app;$(MSBuildThisFileDirectory)src\model;$(MSBuildThisFileDirectory)src\net;$(MSBuildThisFileDirectory)src\prefs;$(ZsCoreDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level3</WarningLevel>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions Condition="'$(ZsDevHooks)'=='true'">ZS_DEV_HOOKS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(ZsCoreDir)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- MinimalCoreWin trims the default libraries, so each Win32 library
           is named here. The core loads Direct3D at run time. -->
      <AdditionalDependencies>zslice.lib;ntdll.lib;ws2_32.lib;advapi32.lib;bcrypt.lib;userenv.lib;shell32.lib;user32.lib;ole32.lib;gdiplus.lib;d2d1.lib;d3d11.lib;CoreMessaging.lib;winhttp.lib;crypt32.lib;secur32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="src\model\zs_model.h" />
    <ClInclude Include="src\model\zs_signs.h" />
    <ClInclude Include="src\model\zs_part_meshes.h" />
    <ClInclude Include="src\model\zs_label.h" />
    <ClInclude Include="src\app\Layer2D.h" />
    <ClInclude Include="src\app\App.xaml.h">
      <DependentUpon>App.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="src\app\MainWindow.xaml.h">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClInclude>
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\app\App.xaml.cpp">
      <DependentUpon>App.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="src\app\MainWindow.xaml.cpp">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="src\app\MainWindow.Plates.cpp" />
    <ClCompile Include="src\app\MainWindow.Settings.cpp" />
    <ClCompile Include="src\app\MainWindow.Tools.cpp" />
    <ClCompile Include="src\app\MainWindow.Cards.cpp" />
    <ClCompile Include="src\app\MainWindow.View.cpp" />
    <ClCompile Include="src\app\MainWindow.Filaments.cpp" />
    <ClCompile Include="src\app\MainWindow.Paint.cpp" />
    <ClCompile Include="src\app\MainWindow.Label.cpp" />
    <ClCompile Include="src\model\zs_label.cpp" />
    <ClCompile Include="src\model\zs_part_meshes.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\app\MainWindow.Support.cpp" />
    <ClCompile Include="src\app\MainWindow.Session.cpp" />
    <ClCompile Include="src\app\MainWindow.Menu.cpp" />
    <ClCompile Include="src\app\MainWindow.ContextMenu.cpp" />
    <ClCompile Include="src\app\MainWindow.Chrome.cpp" />
    <ClCompile Include="src\app\MainWindow.Search.cpp" />
    <ClCompile Include="src\app\MainWindow.Open.cpp" />
    <ClCompile Include="src\app\MainWindow.Summary.cpp" />
    <ClCompile Include="src\app\MainWindow.Layer2D.cpp" />
    <ClCompile Include="src\app\Layer2D.cpp" />
    <!-- The test hooks: -p:ZsDevHooks=true. A shipped build has none. -->
    <ClCompile Include="src\app\MainWindow.DevHooks.cpp" Condition="'$(ZsDevHooks)'=='true'" />
    <ClCompile Include="src\app\MainWindow.Printers.cpp" />
    <ClCompile Include="src\app\MainWindow.Picker.cpp" />
    <ClCompile Include="src\app\MainWindow.Farm.cpp" />
    <ClCompile Include="src\app\MainWindow.Send.cpp" />
    <ClCompile Include="src\app\winrt_glue.cpp" />
    <!-- The printer connections have no WinRT either. -->
    <ClCompile Include="src\net\*.cpp;src\prefs\*.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <!-- The model has no WinRT, so a test program can link it. -->
    <ClCompile Include="src\model\zs_model.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\model\zs_signs.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <Midl Include="src\app\App.idl" />
    <Midl Include="src\app\MainWindow.idl" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\app\App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="src\app\MainWindow.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="3.0.260715.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="ZsCheckCore" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(ZsCoreDir)\lib\zslice.lib')"
           Text="No core at $(ZsCoreDir). Run: pwsh windows\build-core.ps1 -Platform $(Platform)" />
  </Target>

  <!-- The bed models of the printer library travel beside the program. -->
  <Target Name="ZsCopyBeds" AfterTargets="Build">
    <ItemGroup>
      <ZsBed Include="$(MSBuildThisFileDirectory)..\src\printers\beds\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ZsBed)" DestinationFolder="$(OutDir)beds" SkipUnchangedFiles="true" />
  </Target>

  <!-- A command-line build does not run the WinUI markup passes by itself. -->
  <Target Name="ZsGenerateXamlMarkup"
          BeforeTargets="ClCompile"
          DependsOnTargets="MarkupCompilePass1;MarkupCompilePass2"
          Condition="'@(Page)@(ApplicationDefinition)' != ''" />
</Project>
